{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "dataset-triggers",
  "main": "index.js",
  "compatibility_date": "2026-11-01",
  // No web address: it only runs on its schedule.
  "workers_dev": false,
  "preview_urls": false,
  // Every minute; index.js picks the workflows that are due.
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
